{
  "expo": {
    "name": "TransportCity",
    "slug": "transportcity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "transportcity",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080A",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "es.transportcity.app",
      "supportsTablet": true
    },
    "android": {
      "package": "es.transportcity.app",
      "adaptiveIcon": {
        "backgroundColor": "#07080A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07080A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TransportCity usa tu ubicación para mostrarte las paradas cercanas y avisarte de cuándo salir."
        }
      ],
      "expo-font",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
